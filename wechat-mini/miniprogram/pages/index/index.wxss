.index-page {
  padding-top: 24rpx;
  background:
    radial-gradient(circle at 10% 7%, rgba(216, 104, 50, 0.13), transparent 420rpx),
    radial-gradient(circle at 92% 20%, rgba(31, 101, 71, 0.12), transparent 480rpx),
    #f6f1e7;
}

.hero {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 14rpx 0 36rpx;
}

.eyebrow {
  color: #d86832;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -4rpx;
}

.hero-copy {
  margin-top: 18rpx;
  color: #657068;
  font-size: 28rpx;
}

.filter-card {
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(30, 42, 36, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.86);
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid rgba(30, 42, 36, 0.1);
}

.filter-row.last-row {
  border-bottom: 0;
}

.filter-label {
  flex-shrink: 0;
  margin-right: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.segments {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
}

.segment {
  height: 60rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #657068;
  background: transparent;
  font-size: 24rpx;
  line-height: 60rpx;
}

.segment.active {
  color: #ffffff;
  background: #1f6547;
  font-weight: 700;
}

.generate-button {
  width: 100%;
  height: 104rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1f6547;
  box-shadow: 0 18rpx 38rpx rgba(31, 101, 71, 0.22);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 104rpx;
}

.spark {
  margin-right: 12rpx;
  color: #f2c65d;
}

.pool-note {
  display: block;
  margin: 18rpx 0 38rpx;
  color: #657068;
  font-size: 23rpx;
  text-align: center;
}

.result-card {
  overflow: hidden;
  padding: 38rpx 30rpx;
  border: 1rpx solid rgba(30, 42, 36, 0.08);
  border-radius: 34rpx;
  background: #fffdf8;
  box-shadow: 0 28rpx 70rpx rgba(46, 42, 30, 0.11);
}

.result-heading,
.source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-label {
  color: #d86832;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.difficulty {
  color: #d86832;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.meal-title {
  display: block;
  margin-top: 24rpx;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.15;
}

.staple {
  display: block;
  margin-top: 10rpx;
  color: #657068;
  font-size: 27rpx;
}

.quick-facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 30rpx;
}

.fact {
  display: flex;
  flex-direction: column;
  min-height: 108rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f1e7;
}

.fact-label {
  color: #657068;
  font-size: 21rpx;
}

.fact-value {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.fact-value.small {
  font-size: 24rpx;
  line-height: 1.35;
}

.content-section {
  padding: 38rpx 0;
  border-top: 1rpx solid rgba(30, 42, 36, 0.12);
}

.quick-facts + .content-section {
  margin-top: 32rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.section-number {
  color: #d86832;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.section-title-inline {
  font-size: 34rpx;
  font-weight: 800;
}

.shopping-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shopping-chip {
  display: flex;
  gap: 10rpx;
  padding: 15rpx 20rpx;
  border-radius: 999rpx;
  background: #f5dfd1;
  font-size: 25rpx;
}

.amount {
  color: #8b4a2c;
}

.instruction {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.instruction:last-child {
  margin-bottom: 0;
}

.instruction-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #1f6547;
  font-size: 22rpx;
  font-weight: 800;
}

.instruction-index.soft {
  color: #1f6547;
  background: #dfece3;
}

.instruction-text {
  flex: 1;
  padding-top: 5rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 4rpx 0 24rpx;
}

.detail-card {
  padding: 24rpx;
  border: 1rpx solid rgba(30, 42, 36, 0.12);
  border-radius: 22rpx;
}

.detail-title,
.detail-line,
.card-kicker,
.card-title,
.card-copy,
.source-name,
.source-meta {
  display: block;
}

.detail-title {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-line {
  margin-top: 8rpx;
  color: #657068;
  font-size: 23rpx;
  line-height: 1.5;
}

.doneness-card,
.rescue-card {
  padding: 30rpx;
  border-radius: 24rpx;
}

.doneness-card {
  color: #ffffff;
  background: #1f6547;
}

.rescue-card {
  margin-top: 16rpx;
  background: #f5dfd1;
}

.card-kicker {
  color: #cbe0d3;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.card-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.card-copy {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.dark {
  color: #1e2a24;
}

.safety-note {
  margin-top: 26rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #d86832;
  color: #657068;
  font-size: 24rpx;
  line-height: 1.7;
}

.source-row {
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(30, 42, 36, 0.12);
}

.source-name {
  color: #1f6547;
  font-size: 25rpx;
  font-weight: 800;
}

.source-meta {
  margin-top: 6rpx;
  color: #657068;
  font-size: 21rpx;
}

.copy-button {
  height: 66rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(31, 101, 71, 0.22);
  border-radius: 999rpx;
  color: #1f6547;
  background: #dfece3;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 66rpx;
}
