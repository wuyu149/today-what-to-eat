page {
  min-height: 100%;
  color: #1e2a24;
  background: #f6f1e7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  width: 100%;
  min-height: 100vh;
  padding: 40rpx 28rpx 64rpx;
  box-sizing: border-box;
}

.top-nav {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.nav-button {
  min-width: 116rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(30, 42, 36, 0.14);
  border-radius: 999rpx;
  color: #1f6547;
  background: rgba(255, 253, 248, 0.72);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.section-title {
  margin: 0 0 24rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.card {
  padding: 32rpx;
  border: 1rpx solid rgba(30, 42, 36, 0.1);
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 50rpx rgba(46, 42, 30, 0.09);
}

.muted {
  color: #657068;
}
